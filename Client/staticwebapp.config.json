{
    "navigationFallback": {
        "rewrite": "/index.html"
    },
    "mimeTypes": {
        ".wasm": "application/wasm",
        ".json": "application/json",
        ".dll": "application/octet-stream",
        ".dat": "application/octet-stream"
    },
    "globalHeaders": {
        "cache-control": "public, max-age=31536000, immutable"
    },
    "routes": [
        {
            "route": "/index.html",
            "headers": {
                "cache-control": "no-cache"
            }
        }
    ]
}