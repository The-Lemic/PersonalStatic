@using PersonalStaticApp.Client.Models
@using PersonalStaticApp.Shared
@inject HttpClient Http


<div class="section contact">
    <div class="title nats">
        <h2 id="Contact">Get in touch</h2>
    </div>
    <EditForm Model="emailRequest" FormName="EmailForm" OnSubmit="HandleValidSubmit">
        <AntiforgeryToken />
        <ValidationSummary />
        <InputText @bind-Value="emailRequest.Name" placeholder="Name" />
        <InputText @bind-Value="emailRequest.Email" placeholder="Email" />
        <InputTextArea @bind-Value="emailRequest.Body" placeholder="Message" />
        <button type="submit" class="btn btn-primary">Send</button>
    </EditForm>
</div>

@if (isSuccess)
{
    <p>Message sent successfully!</p>
}

@code {
    private EmailRequest emailRequest = new EmailRequest();
    private bool isSuccess = false;

    private async Task HandleValidSubmit()
    {
        try
        {

            var forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>("/api/responsedata") ?? new WeatherForecast[] { };

            var response = await Http.PostAsJsonAsync("/api/contact", emailRequest);
            isSuccess = response.IsSuccessStatusCode;
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
            isSuccess = false;
        }
    }
}