@using PersonalStaticApp.Client.Models
@inject HttpClient Http


<div class="section contact">
    <div class="title nats">
        <h2 id="Contact">Get in touch</h2>
    </div>

    @if (!isSuccess)
    {
        <EditForm Model="emailRequest" FormName="EmailForm" OnValidSubmit="HandleValidSubmit" class="contact-form">
            <DataAnnotationsValidator />
            <AntiforgeryToken />
            <div class="form-group form-group-name">
                <InputText @bind-Value="emailRequest.Name" placeholder="Name" class="form-input input-name" />
                <ValidationMessage For="@(() => emailRequest.Name)" class="validation-message" />
            </div>
            <div class="form-group form-group-email">
                <InputText @bind-Value="emailRequest.Email" placeholder="Email" class="form-input input-email" />
                <ValidationMessage For="@(() => emailRequest.Email)" class="validation-message" />
            </div>
            <div class="form-group form-group-message">
                <InputTextArea @bind-Value="emailRequest.Body" placeholder="Message" class="form-textarea" rows="5" />
                <ValidationMessage For="@(() => emailRequest.Body)" class="validation-message" />
            </div>
            <button type="submit" class="btn-send" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span>Sending...</span>
                }
                else
                {
                    <span>Send</span>
                }
            </button>
        </EditForm>
    }
    else
    {
        <div class="success-message">
            <p>Thank you for reaching out! Your message has been sent successfully.</p>
        </div>
    }
</div>

@if (showErrorToast)
{
    <div class="toast toast-error">
        <div class="toast-content">
            <span>@errorMessage</span>
        </div>
    </div>
}

@code {
    private EmailRequest emailRequest = new EmailRequest();
    private bool isSuccess = false;
    private bool isSubmitting = false;
    private bool showErrorToast = false;
    private string errorMessage = "Failed to send message. Please try again.";

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/contact", emailRequest);

            if (response.IsSuccessStatusCode)
            {
                isSuccess = true;
            }
            else
            {
                // Handle different error responses
                if (response.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
                {
                    errorMessage = "Too many requests. Please try again later.";
                }
                else
                {
                    var errorContent = await response.Content.ReadAsStringAsync();
                    errorMessage = !string.IsNullOrEmpty(errorContent) ? errorContent : "Failed to send message. Please try again.";
                }

                showErrorToast = true;
                StateHasChanged();
                await Task.Delay(5000);
                showErrorToast = false;
                StateHasChanged();
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Request error: {ex.Message}");
            errorMessage = "Connection error. Please check your internet and try again.";
            showErrorToast = true;
            StateHasChanged();
            await Task.Delay(5000);
            showErrorToast = false;
            StateHasChanged();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}