<div class="section">
    <div class="title nats">
        <h2 id="Experience">Experience</h2>
    </div>

    <div class="timeline">
        <div class="timeline-heading">
            <h3>@CalculateYearsExperience() years of proven professional success</h3>
            <p class="numan">Nothing is more important than practical experience.</p>
        </div>

        @* Eploy *@
        <div class="timeline-event">
            <div class="spacer"/>
            <div class="line-container">
                <div class="nats dot">@DateTime.Now.Year</div>
                <div class="line" />
            </div>
            <div class="numan job-details">
                <h4 class="nats">Software Engineer | The Access Group (Eploy)</h4>
                <h5>October 2019 - @DateTime.Now.ToString("MMMM yyyy")</h5>
                <p>Backend engineer on an award-winning Applicant Tracking System and Talent CRM serving 350+ enterprise customers. Contributing to feature development, performance optimization, and infrastructure improvements.</p>
            </div>
        </div>

        @* Eastside *@
        <div class="timeline-event">
            <div class="numan job-details">
                <h4 class="nats">Frontend Developer | Eastside Co</h4>
                <h5>June 2019 - October 2019</h5>
                <p>Developed bespoke features for multiple Shopify e-commerce websites including <a href="https://silqrose.com/">Silq Rose</a> and <a href="https://wardenagri.co.uk/">Warden Agri</a>, extending CMS capabilities with custom functionality. Gained expertise in modern frontend technologies including SASS, HTML5, and JavaScript.</p>
            </div>
            <div class="line-container">
                <div class="nats dot">2019</div>
                <div class="line" />
            </div>
            <div class="spacer"/>
        </div>

        @* Netlynk Direct *@
        <div class="timeline-event">
            <div class="spacer" />
            <div class="line-container">
                <div class="nats dot">2016</div>
                <div class="line" />
            </div>
            <div class="numan job-details">
                <h4 class="nats">Developer | NetLynk Direct</h4>
                <h5>August 2016 - June 2019</h5>
                <p>Full-stack developer for <a href="https://www.plus.net/mobile/">Plusnet mobile</a> and TalkTalk websites using ASP.NET MVC. Built bespoke CMS for content management. Developed skills in C#, HTML, CSS, SEO optimisation, Bootstrap, SVN version control, and JavaScript.</p>
            </div>
        </div>

        @* Wapple *@
        <div class="timeline-event">
            <div class="numan job-details">
                <h4 class="nats">Apprentice C# Developer | Wapple</h4>
                <h5>August 2015 - August 2016</h5>
                <p>Foundation year learning C#, XAML, Entity Framework, and C++. Gained experience with Unity game engine, Microsoft Visual Studio, Windows Universal Platforms, and Windows 8.1 development.</p>
            </div>
            <div class="line-container">
                <div class="nats dot">2015</div>
                <div class="line gradient" />
            </div>
            <div class="spacer" />
        </div>

    </div>
    <hr/>
</div>


@code {
    private int yearsExperience;

    private int CalculateYearsExperience()
    {
        return Convert.ToInt32(Math.Floor((DateTime.Now - new DateTime(2015, 08, 01)).TotalDays / 365));
    }


}